# Server port (default 80)
PORT=3001

# AWS credentials (or use an IAM role / shared config instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 bucket that receives raw uploads (REQUIRED by upload.service.js)
S3_BUCKET=

# S3 bucket with transcoded HLS output + CloudFront in front of it
OUTPUT_BUCKET=
CLOUDFRONT_DOMAIN=
